AUTOINSIGHT_PIPELINE_MODE=llm_clm_jev
AUTOINSIGHT_DATA_DIR=data
AUTOINSIGHT_LOG_DIR=logs
AUTOINSIGHT_SURFACE_THRESHOLD=0.85
AUTOINSIGHT_INVESTIGATE_THRESHOLD=0.60
AUTOINSIGHT_MIN_PEER_COUNT=10
AUTOINSIGHT_MAX_ADDITIONAL_ANALYSIS=1
# Standalone Jev example through OpenRouter (examples/jev_api_demo.py).
OPENROUTER_API_KEY=
JEV_MODEL=~typesafe/jev-latest
OPENROUTER_LLM_MODEL=anthropic/claude-opus-5.5
# Pipeline provider adapters are still pending.
